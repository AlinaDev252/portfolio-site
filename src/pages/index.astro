---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import WorkCard from '../components/WorkCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const jobs = [
  {
    title: 'Front-End Developer',
    company: 'Marbill Technologies',
    dates: 'Jun 2022 – Present',
    place: 'Marbella',
    points: [
      'Developed and maintained 10+ custom storefront themes for a growing e-commerce subscription platform with a high volume of monthly orders.',
      'Shipped 60+ landing pages and promo campaigns with the design and marketing teams, often with tight launch dates.',
      'Built the product, cart, checkout and subscription pages, making them easier to use on mobile and quicker to buy from.',
    ],
  },
  {
    title: 'Freelance / Self-Directed Projects',
    dates: 'Jan 2020 – May 2022',
    place: 'Bucharest',
    points: [
      'Two years teaching myself front-end, from my first HTML page to full Vue apps.',
      'Completed the Udacity Front End Web Developer Nanodegree and the Zero To Mastery Vue.js Developer track.',
    ],
  },
  {
    title: 'Operations Manager',
    company: 'Azelis Romania',
    dates: 'Feb 2011 – Dec 2019',
    place: 'Bucharest',
    points: [
      'Led the customer service team: planned the daily work, set priorities and dealt with issues as they came up, much like working in sprints today.',
    ],
  },
];

const skills = [
  { label: 'Front-end', value: 'HTML5, CSS3, Tailwind CSS, Bootstrap 5, JavaScript (ES6+), Twig (Liquid-style templating), Vue 3, responsive design, HTML email' },
  { label: 'CMS & e-commerce', value: 'Theme development, reusable sections, landing pages, product, cart and checkout pages, multi-language sites' },
  { label: 'UX & quality', value: 'Usability, accessibility, Core Web Vitals, semantic HTML, technical SEO' },
  { label: 'Tools', value: 'Git/GitHub, Figma, Webpack, Firebase, Jest, Jira, ClickUp, AI coding assistants (GitHub Copilot, Claude, Gemini, ChatGPT)' },
  { label: 'Languages', value: 'Romanian (native), Spanish (C2), English (C1)' },
];

const stats = [
  { value: '4+', label: 'years coding' },
  { value: '60+', label: 'landing pages' },
  { value: '10+', label: 'store themes' },
];

const contacts = [
  { label: 'LinkedIn', href: site.linkedin },
  { label: 'GitHub', href: site.github },
];
---
<Base>
  <Hero />

  <Section id="work" title="Selected work" band>
    <p data-reveal class="max-w-xl text-band-muted">Most of my client work is under NDA, so the brands stay unnamed and the projects go by what they are.</p>
    <div class="mt-10 grid gap-x-8 gap-y-14 sm:grid-cols-2">
      {work.map((entry, i) => <WorkCard entry={entry} eager={i < 2} index={i} />)}
    </div>
  </Section>

  <Section id="projects" title="Personal projects">
    <p data-reveal class="max-w-xl text-muted dark:text-night-muted">What I build on my own time, to learn and try new things.</p>
    <div class="mt-8 grid gap-5 lg:grid-cols-3">
      {projects.map((entry, i) => <ProjectCard entry={entry} index={i} />)}
    </div>
    <p data-reveal class="mt-8"><a href={site.github} rel="noopener" class="link text-sm font-medium text-heading dark:text-night-heading">More on GitHub</a></p>
  </Section>

  <Section id="about" title="About">
    <div class="max-w-2xl space-y-5 text-lg leading-relaxed">
      <p data-reveal>I didn't start in tech. I ran a customer service team in Bucharest and was the go-to person when our ERP misbehaved. In 2020 I taught myself front-end, and in 2022 I joined Marbill, where I'm now a senior developer in a team of four.</p>
      <p data-reveal style="--i: 1">What I like most about e-commerce is how quickly you see the result: a faster checkout or a clearer campaign page shows up in the numbers almost right away. That's also why I enjoy working closely with marketing. I'm usually the one who turns their ideas into pages we can ship, and the numbers tell us both what worked.</p>
    </div>
    <p data-reveal style="--i: 2" class="mt-8 flex flex-wrap gap-x-2 gap-y-1 text-lg text-muted dark:text-night-muted">
      {stats.map((stat, i) => (
        <span class="whitespace-nowrap"><span class="font-semibold text-heading dark:text-night-heading">{stat.value}</span> {stat.label}{i < stats.length - 1 && <span aria-hidden="true" class="ml-2">·</span>}</span>
      ))}
    </p>
  </Section>

  <Section id="experience" title="Experience">
    <ol class="space-y-12">
      {jobs.map((job) => (
        <li data-reveal>
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h3 class="font-semibold text-heading dark:text-night-heading">{job.title}{job.company && <span class="font-normal text-muted dark:text-night-muted"> · {job.company}</span>}</h3>
            <p class="text-sm text-muted dark:text-night-muted">{job.dates} · {job.place}</p>
          </div>
          <ul class="mt-3 max-w-2xl list-disc space-y-1.5 pl-5 leading-relaxed marker:text-line dark:marker:text-night-line">
            {job.points.map((point) => <li>{point}</li>)}
          </ul>
        </li>
      ))}
    </ol>
    <p data-reveal class="mt-10"><a href="https://alinadev252.github.io/cv/" rel="noopener" class="link text-sm font-medium text-heading dark:text-night-heading">Full CV with education and certifications</a></p>
  </Section>

  <Section id="skills" title="Skills">
    <dl class="divide-y divide-hairline dark:divide-night-hairline">
      {skills.map((skill, i) => (
        <div data-reveal style={`--i: ${i}`} class="grid gap-1 py-4 first:pt-0 sm:grid-cols-[11rem_1fr] sm:gap-6">
          <dt class="font-semibold text-heading dark:text-night-heading">{skill.label}</dt>
          <dd class="leading-relaxed">{skill.value}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section id="contact" title="Contact">
    <p data-reveal class="max-w-xl text-lg leading-relaxed">I'm looking for remote front-end roles, especially in e-commerce. Email is the quickest way to reach me.</p>
    <p data-reveal style="--i: 1" class="mt-6">
      <a href={`mailto:${site.email}`} class="link font-display text-2xl break-all text-heading sm:text-3xl dark:text-night-heading">{site.email}</a>
    </p>
    <ul data-reveal style="--i: 2" class="mt-8 flex flex-wrap gap-x-8 gap-y-3 font-medium text-heading dark:text-night-heading">
      {contacts.map((c) => (
        <li><a href={c.href} rel="noopener" class="link">{c.label}</a></li>
      ))}
    </ul>
  </Section>
</Base>
