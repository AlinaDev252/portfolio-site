---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Facts from '../components/Facts.astro';
import Section from '../components/Section.astro';
import Principle from '../components/Principle.astro';
import Gallery from '../components/Gallery.vue';
import ProjectCard from '../components/ProjectCard.astro';
import { site, url } from '../data/site';
import { principles } from '../data/principles';
import { storeThemes } from '../data/themes';

const themeGalleries = await Promise.all(
  storeThemes.map((theme) =>
    Promise.all(
      theme.slides.map(async (slide) => {
        const img = await getImage({ src: slide.image, widths: [640, 1000, 1600], format: 'webp' });
        const full = await getImage({ src: slide.image, width: 1920, format: 'webp' });
        const phone = await getImage({ src: slide.phone, widths: [400, 600, 900], format: 'webp' });
        const phoneFull = await getImage({ src: slide.phone, width: 900, format: 'webp' });
        return {
          full: full.src,
          phoneFull: phoneFull.src,
          phone: { src: phone.src, srcset: phone.srcSet.attribute, width: slide.phone.width, height: slide.phone.height },
          desktop: { src: img.src, srcset: img.srcSet.attribute, width: slide.image.width, height: slide.image.height },
          alt: slide.alt,
          phoneAlt: slide.phoneAlt,
          caption: slide.caption,
        };
      }),
    ),
  ),
);

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const jobs = [
  { dates: 'Jun 2022 – Present', title: 'Front-end developer', company: 'Marbill Technologies', place: 'Marbella' },
  { dates: 'Jan 2020 – May 2022', title: 'Freelance / self-directed projects', place: 'Bucharest' },
  { dates: 'Feb 2011 – Dec 2019', title: 'Operations manager', company: 'Azelis Romania', place: 'Bucharest' },
];

const skills = [
  { label: 'Front-end', value: 'HTML5, CSS3, Tailwind CSS, Bootstrap 5, JavaScript (ES6+), Twig (PHP templating, Liquid-style), Vue 3, responsive design, HTML email' },
  { label: 'Shopify', value: 'Liquid, Online Store 2.0 sections and blocks, Dawn-based theme customisation, metafields' },
  { label: 'CMS & e-commerce', value: 'Theme development, reusable sections, landing pages, product, cart and checkout pages, multi-language sites' },
  { label: 'UX & quality', value: 'Usability, accessibility, Core Web Vitals, semantic HTML, technical SEO' },
  { label: 'Tools', value: 'Git/GitHub, Figma, Webpack, Firebase, Jest, Jira, ClickUp, AI coding assistants (GitHub Copilot, Claude, Gemini, ChatGPT)' },
  { label: 'Languages', value: 'Romanian (native), Spanish (C2), English (C1)' },
];

const contacts = [
  { label: 'LinkedIn', href: site.linkedin },
  { label: 'GitHub', href: site.github },
  { label: 'Download CV', href: url(site.cv), download: true },
];
---
<Base>
  <Hero />
  <Facts />

  <Section id="work" title="Selected work" band>
    <p data-reveal class="max-w-xl text-pretty text-band-muted">Four things I care about on every page, and the work that shows it. Brands stay hidden under NDA.</p>
    <div class="mt-12 divide-y divide-band-hairline dark:divide-band-night-hairline">
      {principles.map((principle, i) => <Principle principle={principle} index={i} />)}
    </div>
  </Section>

  <Section id="themes" title="Store themes">
    <p data-reveal class="max-w-xl text-pretty text-muted dark:text-night-muted">Two of the 10+ store themes I've built. Each is a reusable template that can be restyled for a different brand.</p>
    <div class="mt-10 space-y-14">
      {storeThemes.map((theme, i) => (
        <article class="border-t border-hairline pt-10 first:border-t-0 first:pt-0 dark:border-night-hairline">
          <div data-reveal class="max-w-2xl">
            <p aria-hidden="true" class="font-display text-sm text-muted tabular-nums dark:text-night-muted">{String(i + 1).padStart(2, '0')}</p>
            <p class="mt-2 text-xs font-semibold tracking-wide text-muted uppercase dark:text-night-muted">{theme.stack}</p>
            <h3 class="mt-2 font-display text-xl font-medium text-balance text-heading sm:text-2xl dark:text-night-heading">{theme.title}</h3>
            <p class="mt-2 leading-relaxed text-pretty">{theme.body}</p>
          </div>
          <div data-reveal style="--i: 1" class="mt-6">
            <Gallery client:visible slides={themeGalleries[i]} label={theme.name} />
          </div>
        </article>
      ))}
    </div>
  </Section>

  <Section id="projects" title="Personal projects">
    <p data-reveal class="max-w-xl text-pretty text-muted dark:text-night-muted">What I build on my own time, to learn and try new things.</p>
    <div class="mt-8 grid gap-5 lg:grid-cols-3">
      {projects.map((entry, i) => <ProjectCard entry={entry} index={i} />)}
    </div>
    <p data-reveal class="mt-8"><a href={site.github} target="_blank" rel="noopener" class="link relative after:absolute after:-inset-x-1 after:-inset-y-2.5 after:content-[''] text-sm font-medium text-heading dark:text-night-heading">More on GitHub<span class="sr-only"> (opens in a new tab)</span></a></p>
  </Section>

  <Section id="about" title="About">
    <div class="max-w-2xl">
      <p data-reveal class="font-display text-3xl leading-tight font-medium text-balance text-heading sm:text-4xl dark:text-night-heading">I build the pages where people decide to buy.</p>
      <div class="mt-6 space-y-5 text-lg leading-relaxed">
        <p data-reveal style="--i: 1">Product pages, carts, checkouts and the campaign pages that lead to them. I joined Marbill in 2022 and now work in a team of four front-end developers, side by side with the PHP back-end team. <em class="font-display font-medium text-[1.15em] leading-none text-heading dark:text-night-heading not-italic">Six</em> years of code, <em class="font-display font-medium text-[1.15em] leading-none text-heading dark:text-night-heading not-italic">10+</em> store themes and <em class="font-display font-medium text-[1.15em] leading-none text-heading dark:text-night-heading not-italic">100+</em> landing pages.</p>
        <p data-reveal style="--i: 2">What I like most about e-commerce is how quickly you see the result: a faster checkout or a clearer campaign page shows up in the numbers almost right away. That's also why I enjoy working closely with marketing. I'm usually the one who turns their ideas into pages we can ship, and the numbers tell us both what worked.</p>
      </div>
    </div>
  </Section>

  <Section id="experience" title="Experience">
    <ol class="divide-y divide-hairline border-y border-hairline dark:divide-night-hairline dark:border-night-hairline">
      {jobs.map((job, i) => (
        <li data-reveal style={`--i: ${i}`} class="grid gap-1 py-4 lg:grid-cols-[10.5rem_minmax(0,1fr)_auto] lg:items-baseline lg:gap-6">
          <p class="text-sm text-muted tabular-nums dark:text-night-muted">{job.dates}<span class="lg:hidden"> · {job.place}</span></p>
          <h3 class="font-semibold text-heading dark:text-night-heading">{job.title}{job.company && <span class="font-normal text-muted dark:text-night-muted"> · {job.company}</span>}</h3>
          <p class="hidden text-sm text-muted lg:block dark:text-night-muted">{job.place}</p>
        </li>
      ))}
    </ol>
    <p data-reveal class="mt-10"><a href="https://cv.alina-goiea.com/" target="_blank" rel="noopener" class="link relative after:absolute after:-inset-x-1 after:-inset-y-2.5 after:content-[''] text-sm font-medium text-heading dark:text-night-heading">Full CV with education and certifications<span class="sr-only"> (opens in a new tab)</span></a></p>
  </Section>

  <Section id="skills" title="Skills">
    <dl class="divide-y divide-hairline dark:divide-night-hairline">
      {skills.map((skill, i) => (
        <div data-reveal style={`--i: ${i}`} class="grid gap-1 py-4 first:pt-0 sm:grid-cols-[11rem_1fr] sm:gap-6">
          <dt class="font-semibold text-heading dark:text-night-heading">{skill.label}</dt>
          <dd class="leading-relaxed">{skill.value}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section id="contact" title="Contact">
    <p data-reveal class="max-w-xl text-lg leading-relaxed text-pretty">I'm looking for remote front-end roles, especially in e-commerce. Email is the quickest way to reach me.</p>
    <p data-reveal style="--i: 1" class="mt-6">
      <a href={`mailto:${site.email}`} class="link font-display text-2xl break-all text-heading sm:text-3xl dark:text-night-heading">{site.email}</a>
    </p>
    <ul data-reveal style="--i: 2" class="mt-8 flex flex-wrap gap-x-8 gap-y-3 font-medium text-heading dark:text-night-heading">
      {contacts.map((c) => (
        <li><a href={c.href} target={c.download ? undefined : '_blank'} rel={c.download ? undefined : 'noopener'} download={c.download} class="link relative after:absolute after:-inset-x-1 after:-inset-y-2.5 after:content-['']">{c.label}{!c.download && <span class="sr-only"> (opens in a new tab)</span>}</a></li>
      ))}
    </ul>
  </Section>
</Base>
