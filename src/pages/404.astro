---
import Base from '../layouts/Base.astro';
import { url } from '../data/site';
---
<Base title="Page not found" description="This page doesn't exist." noindex>
  <section class="mx-auto max-w-5xl px-4 py-24 sm:px-6 sm:py-32">
    <p class="text-sm font-medium text-muted dark:text-night-muted">404</p>
    <h1 class="mt-3 font-display text-4xl font-medium text-heading dark:text-night-heading sm:text-5xl">This page isn't here</h1>
    <p class="mt-5 max-w-lg text-lg leading-relaxed">The link may be old, or the project may have moved. Everything I'm showing is on the homepage.</p>
    <p class="mt-8 flex flex-wrap gap-x-6 gap-y-3 font-medium text-heading dark:text-night-heading">
      <a href={url()} class="link">Go to the homepage</a>
      <a href={url('#work')} class="link">See selected work</a>
    </p>
  </section>
</Base>
