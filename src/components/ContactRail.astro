---
import SocialLinks from './SocialLinks.astro';
---
<aside transition:persist="contact-rail" aria-label="Contact links" class="fixed bottom-0 left-6 z-30 hidden flex-col items-center gap-4 print:hidden xl:flex">
  <SocialLinks vertical class="rounded-full border border-hairline bg-paper p-1.5 shadow-lift dark:border-night-hairline dark:bg-night-surface dark:shadow-lift-night" />
  <span aria-hidden="true" class="h-20 w-px bg-line dark:bg-night-line"></span>
</aside>
