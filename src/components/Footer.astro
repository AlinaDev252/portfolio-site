---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="border-t border-hairline dark:border-night-hairline">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-8 text-sm text-muted dark:text-night-muted sm:px-6">
    <p>© {year} {site.name}</p>
    <p>Based in Málaga, working remotely</p>
  </div>
</footer>
