---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="border-t border-hairline dark:border-night-hairline">
  <div class="mx-auto max-w-5xl space-y-1 px-4 py-8 text-center text-sm text-muted dark:text-night-muted sm:px-6">
    <p>© {year} {site.name}</p>
    <p>Built with Astro, Tailwind CSS and Vue</p>
  </div>
</footer>
