---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { url } from '../data/site';

interface Props {
  entry: CollectionEntry<'work'>;
  eager?: boolean;
  index?: number;
}
const { entry, eager = false, index = 0 } = Astro.props;
const { title, summary, kind, year, cover, coverAlt } = entry.data;
---
<article class="group relative" data-reveal style={`--i: ${index % 2}`}>
  <div class="relative overflow-hidden rounded-xl border border-band-hairline bg-tint transition-[translate,box-shadow] duration-500 ease-(--ease-soft) group-hover:-translate-y-1 group-hover:shadow-lift-band group-has-[:focus-visible]:-translate-y-1 group-has-[:focus-visible]:shadow-lift-band dark:border-band-night-hairline dark:bg-night-surface">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 1024px) 460px, (min-width: 640px) 45vw, 100vw"
      loading={eager ? 'eager' : 'lazy'}
      class="aspect-[4/3] w-full object-cover transition-[scale] duration-700 ease-(--ease-soft) group-hover:scale-[1.03] group-has-[:focus-visible]:scale-[1.03]"
    />
    <span aria-hidden="true" class="pointer-events-none absolute bottom-3 left-3 -translate-x-3 rounded-full bg-paper/95 px-3 py-1.5 text-xs font-medium text-heading opacity-0 shadow-sm transition-[opacity,translate] duration-300 ease-(--ease-soft) group-hover:translate-x-0 group-hover:opacity-100 group-has-[:focus-visible]:translate-x-0 group-has-[:focus-visible]:opacity-100 motion-reduce:translate-x-0 dark:bg-ink/95 dark:text-night-heading [@media(hover:none)]:translate-x-0 [@media(hover:none)]:opacity-100">View case study →</span>
  </div>
  <p class="mt-5 text-sm text-band-muted">{kind} · {year}</p>
  <h3 class="mt-1.5 font-display text-xl font-medium text-band-heading">
    <a href={url(`work/${entry.id}/`)} class="grow-line after:absolute after:inset-0 after:content-['']">{title}</a>
  </h3>
  <p class="mt-2 leading-relaxed">{summary}</p>
</article>
