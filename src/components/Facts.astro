---
import { site } from '../data/site';
---
<section aria-label="At a glance" class="mx-auto max-w-5xl px-4 sm:px-6">
  <dl class="grid gap-x-8 gap-y-8 border-t border-hairline pt-8 pb-16 sm:grid-cols-2 sm:pb-20 lg:grid-cols-4 dark:border-night-hairline">
    {site.facts.map((fact, i) => (
      <div data-reveal style={`--i: ${i}`} class="min-w-0">
        <dt class="text-xs font-semibold tracking-wide text-muted uppercase dark:text-night-muted">{fact.label}</dt>
        <dd class="mt-2 font-display text-xl font-medium text-heading dark:text-night-heading">{fact.title}</dd>
        <dd class="mt-1.5 text-pretty text-sm leading-relaxed text-muted dark:text-night-muted">{fact.text}</dd>
      </div>
    ))}
  </dl>
</section>
