---
import ThemeToggle from './ThemeToggle.vue';
import { site, url } from '../data/site';

const onWork = Astro.url.pathname.includes('/work/');

const links = [
  { href: url('#work'), label: 'Work', current: onWork },
  { href: url('#about'), label: 'About' },
  { href: url('#contact'), label: 'Contact' },
];
---
<header transition:name="site-header" class="sticky top-0 z-40 border-b border-hairline bg-paper dark:border-night-hairline dark:bg-ink">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-2 px-4 py-3 max-[359px]:px-3 sm:gap-4 sm:px-6">
    <a href={url()} class="block rounded" aria-label={`${site.name}, home`}>
      <span class="font-display text-lg font-semibold tracking-tight max-[359px]:text-base whitespace-nowrap text-heading sm:text-xl md:text-2xl dark:text-night-heading">{site.name}</span>
    </a>
    <div class="flex items-center gap-1 sm:gap-3">
      <nav aria-label="Main">
        <ul class="flex items-center gap-1 max-[359px]:gap-0 text-sm font-medium sm:gap-2">
          {links.map((link) => (
            <li>
              <a href={link.href} aria-current={link.current ? 'true' : undefined} class="relative inline-block rounded-md px-2 py-2 max-[359px]:px-1.5 text-heading transition-colors after:absolute after:inset-x-2 after:bottom-1.5 after:h-px after:origin-left after:scale-x-0 after:bg-current after:transition-transform after:duration-300 after:ease-(--ease-soft) after:content-[''] hover:text-accent hover:after:scale-x-100 focus-visible:after:scale-x-100 aria-[current=true]:after:scale-x-100 dark:text-night-heading dark:hover:text-accent-bright sm:px-3 sm:after:inset-x-3">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemeToggle client:load />
    </div>
  </div>
</header>
