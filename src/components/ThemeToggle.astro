<button
  type="button"
  data-theme-toggle
  aria-label="Night mode"
  aria-pressed="false"
  class="grid size-11 place-items-center rounded-md text-heading transition-colors hover:text-accent max-[359px]:size-10 dark:text-night-heading dark:hover:text-accent-bright"
>
  <svg aria-hidden="true" class="theme-icon col-start-1 row-start-1 size-5 transition-[opacity,scale,filter] duration-300 ease-[cubic-bezier(0.25,0.1,0,1)] motion-reduce:transition-none dark:scale-30 dark:opacity-0 dark:blur-[3px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg aria-hidden="true" class="theme-icon col-start-1 row-start-1 size-5 scale-30 opacity-0 blur-[3px] transition-[opacity,scale,filter] duration-300 ease-[cubic-bezier(0.25,0.1,0,1)] motion-reduce:transition-none dark:scale-100 dark:opacity-100 dark:blur-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
</button>

<script>
  const root = document.documentElement;
  let settle = 0;

  const saved = () => {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  };

  const sync = () => {
    const dark = root.classList.contains('dark');
    document.querySelectorAll('[data-theme-toggle]').forEach((el) => el.setAttribute('aria-pressed', String(dark)));
  };

  const apply = (dark: boolean) => {
    root.classList.toggle('dark', dark);
    sync();
  };

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]')) return;
    const dark = !root.classList.contains('dark');
    root.classList.add('theme-anim');
    apply(dark);
    clearTimeout(settle);
    settle = window.setTimeout(() => root.classList.remove('theme-anim'), 300);
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
  });

  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    if (!saved()) apply(event.matches);
  });

  sync();
</script>
