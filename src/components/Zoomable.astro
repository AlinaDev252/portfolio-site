---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  image: ImageMetadata;
  alt: string;
  label: string;
  dark?: boolean;
}
const { id, image, alt, label, dark = false } = Astro.props;
const full = await getImage({ src: image, width: Math.min(image.width, 1920) });
---
<button
  type="button"
  data-zoom={id}
  aria-label={`Enlarge: ${label}`}
  class:list={[
    'group relative block w-full cursor-zoom-in overflow-hidden rounded-xl border focus-visible:outline-2 focus-visible:outline-offset-4',
    dark ? 'border-band-hairline dark:border-band-night-hairline' : 'border-hairline dark:border-night-hairline',
  ]}
>
  <Image
    src={image}
    alt={alt}
    widths={[720, 1080, 1440]}
    sizes="(min-width: 1024px) 720px, 100vw"
    class="w-full transition-transform duration-500 ease-(--ease-soft) group-hover:scale-[1.015]"
  />
  <span aria-hidden="true" class="absolute right-3 bottom-3 rounded-full bg-ink/75 px-3 py-1 text-xs font-medium text-white opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100 [@media(hover:none)]:opacity-100"><span class="[@media(hover:none)]:hidden">Click</span><span class="hidden [@media(hover:none)]:inline">Tap</span> to enlarge</span>
</button>
<dialog
  id={id}
  aria-label={label}
  class="m-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-ink/85 backdrop:backdrop-blur-sm [&_:focus-visible]:outline-white"
>
  <form method="dialog" class="contents">
    <button type="submit" aria-label="Close" class="block cursor-zoom-out p-4">
      <img src={full.src} alt={alt} loading="lazy" decoding="async" class="max-h-[calc(100dvh-2rem)] max-w-[calc(100vw-2rem)] rounded-lg object-contain" />
    </button>
  </form>
</dialog>

<script>
  document.addEventListener('click', (event) => {
    const trigger = (event.target as Element).closest<HTMLElement>('[data-zoom]');
    if (!trigger) return;
    const dialog = document.getElementById(trigger.dataset.zoom!) as HTMLDialogElement | null;
    dialog?.showModal();
  });
  document.addEventListener('click', (event) => {
    const dialog = event.target as Element;
    if (dialog instanceof HTMLDialogElement && dialog.open) dialog.close();
  });
</script>
