---
interface Props {
  id: string;
  title: string;
  band?: boolean;
}
const { id, title, band = false } = Astro.props;
---
<section
  id={id}
  aria-labelledby={`${id}-title`}
  class:list={[
    band
      ? 'band bg-band text-band-text dark:bg-band-night'
      : 'border-t border-hairline dark:border-night-hairline [.band+&]:border-t-0',
  ]}
>
  <div class="mx-auto grid max-w-5xl gap-6 px-4 py-16 sm:px-6 sm:py-20 md:grid-cols-[13rem_1fr] md:gap-12">
    <h2
      id={`${id}-title`}
      data-reveal
      class:list={[
        'font-display text-2xl font-medium md:text-[1.75rem] md:leading-tight',
        band ? 'text-band-heading' : 'text-heading dark:text-night-heading',
      ]}
    >{title}</h2>
    <div class="min-w-0">
      <slot />
    </div>
  </div>
</section>
