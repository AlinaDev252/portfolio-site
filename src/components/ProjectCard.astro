---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
  index?: number;
}
const { entry, index = 0 } = Astro.props;
const { title, summary, stack, status, liveUrl, repoUrl } = entry.data;
const links = [
  { label: 'Live site', href: liveUrl },
  { label: 'Code', href: repoUrl },
].filter((l) => l.href);
const quick = status === 'in-progress' ? undefined : liveUrl ? { label: 'View live', href: liveUrl } : repoUrl ? { label: 'View code', href: repoUrl } : undefined;
---
<article data-reveal style={`--i: ${index}`} class="group flex flex-col rounded-xl border border-hairline p-5 dark:border-night-hairline">
  <div class="flex items-baseline justify-between gap-3">
    <h3 class="font-semibold text-heading dark:text-night-heading">{title}</h3>
    {quick && (
      <a href={quick.href} rel="noopener" tabindex="-1" aria-hidden="true" class="shrink-0 -translate-x-2 text-sm font-medium whitespace-nowrap text-accent opacity-0 transition-[opacity,translate] duration-300 ease-(--ease-soft) group-focus-within:translate-x-0 group-focus-within:opacity-100 group-hover:translate-x-0 group-hover:opacity-100 hover:text-accent-deep motion-reduce:translate-x-0 dark:text-accent-bright [@media(hover:none)]:translate-x-0 [@media(hover:none)]:opacity-100">{quick.label} <span>→</span></a>
    )}
  </div>
  <p class="mt-2 leading-relaxed">{summary}</p>
  <p class="mt-3 text-sm text-muted dark:text-night-muted">{stack.join(' · ')}</p>
  <div class="mt-auto pt-5">
    {status === 'in-progress' || links.length === 0 ? (
      <span class="inline-block rounded-full border border-hairline px-2.5 py-0.5 text-xs text-muted dark:border-night-hairline dark:text-night-muted">In progress</span>
    ) : (
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium text-heading dark:text-night-heading">
        {links.map((l) => (
          <li><a href={l.href} rel="noopener" class="link">{l.label}<span class="sr-only"> for {title}</span></a></li>
        ))}
      </ul>
    )}
  </div>
</article>
